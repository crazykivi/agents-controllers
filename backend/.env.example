# --- Agents Controllers backend ---
# В DEV копируется как backend/.env и подхватывается через godotenv.
# В ПРОД: /etc/agents-controllers/.env (chmod 600) или env из systemd/docker;
# с диска проекта .env в проде не читается.

# Адрес слушания HTTP-сервера
ADDR=:8080

# Папка данных: agents.json, tasks.json
DATA_DIR=data

# Папка со сборкой фронтенда (frontend/dist), раздаётся как SPA
STATIC_DIR=../frontend/dist

# Бинарь aider (должен быть в PATH или абсолютный путь)
AIDER_BIN=aider

# Python с установленными crewai/crewai-tools
PYTHON_BIN=python

# Путь к crew-runner скрипту
RUNNER_PATH=../runner/crew_run.py

# CORS-whitelist через запятую (пусто = только same-origin)
ALLOW_CORS=

# Trusted proxies (CIDR) через запятую, пусто = отключены
TRUSTED_PROXIES=

# Размер кольцевого буфера логов на один поток событий
LOG_TAIL=1000

# Режим gin: release|debug
GIN_MODE=release

# Ключи моделей. ВНИМАНИЕ: aider умеет брать ключ из своего конфига (~/.aider.env),
# но crewai (crew-runner) читает ТОЛЬКО переменные окружения процесса.
# Для моделей openrouter/... нужен OPENROUTER_API_KEY (допустим fallback на OPENAI_API_KEY).
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
